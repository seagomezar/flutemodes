%%barsperstaff 2
M:C
L:1/16
Q:1/4=112
K:E
V:1 clef=treble
%%score 1
(EGBcBABG) (GBefedeB) | (Begagfge) (egbc'babg) |
(Begagfge) (GBefedeB) | (EGBegbeg) (BeGB) .E2 z2 |]

