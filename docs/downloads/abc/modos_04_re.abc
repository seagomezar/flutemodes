X:6
T:Modo 6: Re Frigio
% Familia Menor | Carácter: Oscuro y exótico | Fórmula: 1 - ♭2 - ♭3 - 4 - 5 - ♭6 - ♭7
%%barsperstaff 2
M:4/2
L:1/8
Q:1/2=90
K:Dm
V:1 clef=treble
%%score 1
(D_EFG ABcd) (_edcB AGF_E) | (FGAB cd_ef) (gf_ed cBAG) |
(ABcd _efga) (bagf _edcB) | (cd_ef gabc') (d'c'ba gf_ed) |
(cd_ef gabc') (bagf _edcB) | (ABcd _efga) (gf_ed cBAG) |
(FGAB cd_ef) (_edcB AGF_E) | (D_EFG ABcd) (cBAG F_ED2) |]

X:7
