%%barsperstaff 2
M:4/2
L:1/8
Q:1/2=90
K:Ab
V:1 clef=treble
%%score 1
(ABc=d efga) (bagf e=dcB) | (c=def gabc') (=d'c'ba gfe=d) |
(efga bc'=d'e') (f'e'=d'c' bagf) | (gabc' =d'e'f'g') (a'g'f'e' =d'c'ba) |
(gabc' =d'e'f'g') (f'e'=d'c' bagf) | (efga bc'=d'e') (=d'c'ba gfe=d) |
(c=def gabc') (bagf e=dcB) | (ABc=d efga) (gfe=d cBA2) |]

