% --- 1. Do Mayor (C Major) ---
[K:C] !segno!(cGABcd ecdefg | gefgab c'bagfe | agfedc BAGFED | CEGceg !wedge!c'2) !fine!z2 z2 |]
% --- 2. La menor (Relatif Mineur) ---
[K:Am] (ae^f^gab c'abc'd'e' | e'c'd'e'^f'^g' a'=g'=f'e'd'c' | f'e'd'c'ba gfedcB | Aceac'e' !wedge!a'2) z2 z2 ||
% --- 3. Fa Mayor (F Major) ---
[K:F] (fcdefg afgabc' | c'abc'd'e' f'e'd'c'ba | d'c'bagf edcBAG | FAcfac' !wedge!f'2) z2 z2 ||
% --- 4. Re menor (Mineur) ---
[K:Dm] (dA=B^cde fdefga | afga=b^c' d'=c'_bagf | bagfed cBAGFE | DFAdfa !wedge!d'2) z2 z2 ||
% --- 5. Si♭ Mayor (B♭ Major) ---
[K:Bb] (bfgabc' d'bc'd'e'f' | f'd'e'f'g'a' b'a'g'f'e'd' | g'f'e'd'c'b agfedc | Bdfbd'f' !wedge!b'2) z2 z2 ||
% --- 6. Sol menor (Mineur) ---
[K:Gm] (gd=e^fga bgabc'd' | d'bc'd'=e'^f' g'=f'_e'd'c'b | e'd'c'bag fedcBA | GBdgbd' !wedge!g'2) z2 z2 ||
% --- 7. Mi♭ Mayor (E♭ Major) ---
[K:Eb] (eBcdef gefgab | bgabc'd' e'd'c'bag | c'bagfe dcBAGF | EGBegb !wedge!e'2) z2 z2 ||
% --- 8. Do menor (Mineur) ---
[K:Cm] (cG=A=Bcd ecdefg | gefg=a=b c'_b_agfe | agfedc BAGFED | CEGceg !wedge!c'2) z2 z2 ||
% --- 9. La♭ Mayor (A♭ Major) ---
[K:Ab] (aefgab c'abc'd'e' | e'c'd'e'f'g' a'g'f'e'd'c' | f'e'd'c'ba gfedcB | Aceac'e' !wedge!a'2) z2 z2 ||
% --- 10. Fa menor (Mineur) ---
[K:Fm] (fc=d=efg afgabc' | c'abc'=d'=e' f'_e'_d'c'ba | d'c'bagf edcBAG | FAcfac' !wedge!f'2) z2 z2 ||
% --- 11. Re♭ Mayor (D♭ Major) ---
