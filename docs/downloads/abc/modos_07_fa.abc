X:7
T:Modo 7: Fa Lócrio
% Familia Menor | Carácter: Inestable y tenso | Fórmula: 1 - ♭2 - ♭3 - 4 - ♭5 - ♭6 - ♭7
%%barsperstaff 2
M:4/2
L:1/8
Q:1/2=90
K:Fm
V:1 clef=treble
%%score 1
(F_GAB _cdef) (_gfed _cBA_G) | (AB_cd ef_ga) (ba_gf ed_cB) |
(_cdef _gab_c') (d'_c'ba _gfed) | (ef_ga b_c'd'e') (f'e'd'_c' ba_gf) |
(ef_ga b_c'd'e') (d'_c'ba _gfed) | (_cdef _gab_c') (ba_gf ed_cB) |
(AB_cd ef_ga) (_gfed _cBA_G) | (F_GAB _cdef) (ed_cB A_GF2) |]