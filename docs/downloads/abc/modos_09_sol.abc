X:1
T:Modo 1: Sol Jónico (Mayor)
% Familia Mayor | Carácter: Brillante y luminoso | Fórmula: 1 - 2 - 3 - 4 - 5 - 6 - 7
%%barsperstaff 2
M:4/2
L:1/8
Q:1/2=90
K:G
V:1 clef=treble
%%score 1
(GABc defg) (agfe dcBA) | (Bcde fgab) (c'bag fedc) |
(defg abc'd') (e'd'c'b agfe) | (fgab c'd'e'f') (g'f'e'd' c'bag) |
(fgab c'd'e'f') (e'd'c'b agfe) | (defg abc'd') (c'bag fedc) |
(Bcde fgab) (agfe dcBA) | (GABc defg) (fedc BAG2) |]

X:2
T:Modo 2: Sol Lidio
% Familia Mayor | Carácter: Etéreo y soñador | Fórmula: 1 - 2 - 3 - ♯4 - 5 - 6 - 7
%%barsperstaff 2
M:4/2
L:1/8
Q:1/2=90
K:G
V:1 clef=treble
%%score 1
(GAB^c defg) (agfe d^cBA) | (B^cde fgab) (^c'bag fed^c) |
(defg ab^c'd') (e'd'^c'b agfe) | (fgab ^c'd'e'f') (g'f'e'd' ^c'bag) |
(fgab ^c'd'e'f') (e'd'^c'b agfe) | (defg ab^c'd') (^c'bag fed^c) |
(B^cde fgab) (agfe d^cBA) | (GAB^c defg) (fed^c BAG2) |]

X:3
T:Modo 3: Sol Mixolidio
% Familia Mayor | Carácter: Festivo y folclórico | Fórmula: 1 - 2 - 3 - 4 - 5 - 6 - ♭7
%%barsperstaff 2
M:4/2
L:1/8
Q:1/2=90
K:G
V:1 clef=treble
%%score 1
(GABc de=fg) (ag=fe dcBA) | (Bcde =fgab) (c'bag =fedc) |
(de=fg abc'd') (e'd'c'b ag=fe) | (=fgab c'd'e'=f') (g'=f'e'd' c'bag) |
(=fgab c'd'e'=f') (e'd'c'b ag=fe) | (de=fg abc'd') (c'bag =fedc) |
(Bcde =fgab) (ag=fe dcBA) | (GABc de=fg) (=fedc BAG2) |]

X:4
