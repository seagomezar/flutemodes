[K:Bbm] (bf=g=a).b.c' (d'bc'd').e'.f' | (f'd'e'f').=g'.=a' (b'_a'_g'f').e'.d' | (g'f'e'd').c'.b (agfe).d.c | (Bdfb).d'.f' !wedge!b'2 z2 z2 ||
