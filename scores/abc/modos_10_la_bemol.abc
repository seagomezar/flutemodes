%%barsperstaff 2
M:4/2
L:1/8
Q:1/2=90
K:Ab
V:1 clef=treble
%%score 1
(ABcd ef_ga) (ba_gf edcB) | (cdef _gabc') (d'c'ba _gfed) |
(ef_ga bc'd'e') (f'e'd'c' ba_gf) | (_gabc' d'e'f'_g') (a'_g'f'e' d'c'ba) |
(_gabc' d'e'f'_g') (f'e'd'c' ba_gf) | (ef_ga bc'd'e') (d'c'ba _gfed) |
(cdef _gabc') (ba_gf edcB) | (ABcd ef_ga) (_gfed cBA2) |]

