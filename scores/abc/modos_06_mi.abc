(Bc=de fgab) (c'bag fe=dc) | (=defg abc'=d') (e'=d'c'b agfe) |
(=defg abc'=d') (c'bag fe=dc) | (Bc=de fgab) (agfe =dcBA) |
(GABc =defg) (fe=dc BAGF) | (EFGA Bc=de) (=dcBA GFE2) |]

