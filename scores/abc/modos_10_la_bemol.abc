X:1
T:Modo 1: La bemol (La♭) Jónico (Mayor)
% Familia Mayor | Carácter: Brillante y luminoso | Fórmula: 1 - 2 - 3 - 4 - 5 - 6 - 7
%%barsperstaff 2
M:4/2
L:1/8
Q:1/2=90
K:Ab
V:1 clef=treble
%%score 1
(ABcd efga) (bagf edcB) | (cdef gabc') (d'c'ba gfed) |
(efga bc'd'e') (f'e'd'c' bagf) | (gabc' d'e'f'g') (a'g'f'e' d'c'ba) |
(gabc' d'e'f'g') (f'e'd'c' bagf) | (efga bc'd'e') (d'c'ba gfed) |
(cdef gabc') (bagf edcB) | (ABcd efga) (gfed cBA2) |]

X:2
