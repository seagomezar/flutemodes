L:1/8
Q:1/2=80
K:F#m
V:1 clef=treble
%%score 1
(FGABc^def) (gfedcBAG) | (ABc^defga) (bagfedcB) |
(c^defgabc') (^d'c'bagfed) | (efgabc'^d'e') (f'e'd'c'bagf) |
(efgabc'^d'e') (d'c'bagfe^d) | (c^defgabc') (bagfedcB) |
(ABc^defga) (gfedcBAG) | (FGABc^def) (edcBAG F2) |]

