% --- 13. Sol♭ Mayor (G♭ Major) ---
[K:Gb] (gdefga bgabc'd' | d'bc'd'e'f' g'f'e'd'c'b | e'd'c'bag fedcBA | GBdgbd' !wedge!g'2) z2 z2 ||
% --- 14. Mi♭ menor (Mineur) ---
[K:Ebm] (eB=c=def gefgab | bgab=c'=d' e'_d'_c'bag | c'bagfe dcBAGF | EGBegb !wedge!e'2) z2 z2 ||
% --- 15. Si Mayor (B Major) ---
[K:B] (bfgabc' d'bc'd'e'f' | f'd'e'f'g'a' b'a'g'f'e'd' | g'f'e'd'c'b agfedc | Bdfbd'f' !wedge!b'2) z2 z2 ||
