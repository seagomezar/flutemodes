% Familia Menor | Carácter: Melancólico y noble | Fórmula: 1 - 2 - ♭3 - 4 - 5 - 6 - ♭7
%%barsperstaff 2
M:4/2
L:1/8
Q:1/2=90
K:Gm
V:1 clef=treble
%%score 1
(GABc d=efg) (agf=e dcBA) | (Bcd=e fgab) (c'bag f=edc) |
(d=efg abc'd') (=e'd'c'b agf=e) | (fgab c'd'=e'f') (g'f'=e'd' c'bag) |
(fgab c'd'=e'f') (=e'd'c'b agf=e) | (d=efg abc'd') (c'bag f=edc) |
(Bcd=e fgab) (agf=e dcBA) | (GABc d=efg) (f=edc BAG2) |]

