L:1/8
Q:1/2=90
K:Dm
V:1 clef=treble
%%score 1
(D_EFG _ABcd) (_edcB _AGF_E) | (FG_AB cd_ef) (gf_ed cB_AG) |
(_ABcd _efg_a) (b_agf _edcB) | (cd_ef g_abc') (d'c'b_a gf_ed) |
(cd_ef g_abc') (b_agf _edcB) | (_ABcd _efg_a) (gf_ed cB_AG) |
(FG_AB cd_ef) (_edcB _AGF_E) | (D_EFG _ABcd) (cB_AG F_ED2) |]