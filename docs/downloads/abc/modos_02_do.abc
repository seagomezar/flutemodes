X:1
T:Modo 1: Do Jónico (Mayor)
% Familia Mayor | Carácter: Brillante y luminoso | Fórmula: 1 - 2 - 3 - 4 - 5 - 6 - 7
%%barsperstaff 2
M:4/2
L:1/8
Q:1/2=90
K:C
V:1 clef=treble
%%score 1
(CDEF GABc) (dcBA GFED) | (EFGA Bcde) (fedc BAGF) |
(GABc defg) (agfe dcBA) | (Bcde fgab) (c'bag fedc) |
(Bcde fgab) (agfe dcBA) | (GABc defg) (fedc BAGF) |
(EFGA Bcde) (dcBA GFED) | (CDEF GABc) (BAGF EDC2) |]

