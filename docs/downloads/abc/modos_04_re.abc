X:1
T:Modo 1: Re Jónico (Mayor)
% Familia Mayor | Carácter: Brillante y luminoso | Fórmula: 1 - 2 - 3 - 4 - 5 - 6 - 7
%%barsperstaff 2
M:4/2
L:1/8
Q:1/2=90
K:D
V:1 clef=treble
%%score 1
(DEFG ABcd) (edcB AGFE) | (FGAB cdef) (gfed cBAG) |
(ABcd efga) (bagf edcB) | (cdef gabc') (d'c'ba gfed) |
(cdef gabc') (bagf edcB) | (ABcd efga) (gfed cBAG) |
(FGAB cdef) (edcB AGFE) | (DEFG ABcd) (cBAG FED2) |]

X:2
T:Modo 2: Re Lidio
% Familia Mayor | Carácter: Etéreo y soñador | Fórmula: 1 - 2 - 3 - ♯4 - 5 - 6 - 7
%%barsperstaff 2
M:4/2
L:1/8
Q:1/2=90
K:D
V:1 clef=treble
%%score 1
(DEF^G ABcd) (edcB A^GFE) | (F^GAB cdef) (^gfed cBA^G) |
(ABcd ef^ga) (ba^gf edcB) | (cdef ^gabc') (d'c'ba ^gfed) |
(cdef ^gabc') (ba^gf edcB) | (ABcd ef^ga) (^gfed cBA^G) |
(F^GAB cdef) (edcB A^GFE) | (DEF^G ABcd) (cBA^G FED2) |]

X:3
T:Modo 3: Re Mixolidio
% Familia Mayor | Carácter: Festivo y folclórico | Fórmula: 1 - 2 - 3 - 4 - 5 - 6 - ♭7
%%barsperstaff 2
M:4/2
L:1/8
Q:1/2=90
K:D
V:1 clef=treble
%%score 1
(DEFG AB=cd) (ed=cB AGFE) | (FGAB =cdef) (gfed =cBAG) |
(AB=cd efga) (bagf ed=cB) | (=cdef gab=c') (d'=c'ba gfed) |
(=cdef gab=c') (bagf ed=cB) | (AB=cd efga) (gfed =cBAG) |
(FGAB =cdef) (ed=cB AGFE) | (DEFG AB=cd) (=cBAG FED2) |]

X:4
T:Modo 4: Re Dórico
% Familia Menor | Carácter: Melancólico y noble | Fórmula: 1 - 2 - ♭3 - 4 - 5 - 6 - ♭7
%%barsperstaff 2
M:4/2
L:1/8
Q:1/2=90
K:Dm
V:1 clef=treble
%%score 1
(DEFG A=Bcd) (edc=B AGFE) | (FGA=B cdef) (gfed c=BAG) |
(A=Bcd efga) (=bagf edc=B) | (cdef ga=bc') (d'c'=ba gfed) |
(cdef ga=bc') (=bagf edc=B) | (A=Bcd efga) (gfed c=BAG) |
(FGA=B cdef) (edc=B AGFE) | (DEFG A=Bcd) (c=BAG FED2) |]

