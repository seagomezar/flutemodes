(ef=ga b=c'd'e') (d'=c'ba =gfed) | (=cdef =gab=c') (ba=gf ed=cB) |
(AB=cd ef=ga) (=gfed =cBA=G) | (F=GAB =cdef) (ed=cB A=GF2) |]