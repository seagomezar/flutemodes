X:1
T:Modo 1: Si bemol (Si♭) Jónico (Mayor)
% Familia Mayor | Carácter: Brillante y luminoso | Fórmula: 1 - 2 - 3 - 4 - 5 - 6 - 7
%%barsperstaff 2
M:4/2
L:1/8
Q:1/2=90
K:Bb
V:1 clef=treble
%%score 1
(Bcde fgab) (c'bag fedc) | (defg abc'd') (e'd'c'b agfe) |
(fgab c'd'e'f') (g'f'e'd' c'bag) | (abc'd' e'f'g'a') (b'a'g'f' e'd'c'b) |
(abc'd' e'f'g'a') (g'f'e'd' c'bag) | (fgab c'd'e'f') (e'd'c'b agfe) |
(defg abc'd') (c'bag fedc) | (Bcde fgab) (agfe dcB2) |]

