X:1
T:Modo 1: Fa sostenido (Fa♯) Jónico (Mayor)
% Familia Mayor | Carácter: Brillante y luminoso | Fórmula: 1 - 2 - 3 - 4 - 5 - 6 - 7
%%barsperstaff 2
M:4/2
L:1/8
Q:1/2=90
K:F#
V:1 clef=treble
%%score 1
(FGAB cdef) (gfed cBAG) | (ABcd efga) (bagf edcB) |
(cdef gabc') (d'c'ba gfed) | (efga bc'd'e') (f'e'd'c' bagf) |
(efga bc'd'e') (d'c'ba gfed) | (cdef gabc') (bagf edcB) |
(ABcd efga) (gfed cBAG) | (FGAB cdef) (edcB AGF2) |]

X:2
T:Modo 2: Fa sostenido (Fa♯) Lidio
% Familia Mayor | Carácter: Etéreo y soñador | Fórmula: 1 - 2 - 3 - ♯4 - 5 - 6 - 7
%%barsperstaff 2
M:4/2
L:1/8
Q:1/2=90
K:F#
V:1 clef=treble
%%score 1
(FGA^B cdef) (gfed c^BAG) | (A^Bcd efga) (^bagf edc^B) |
(cdef ga^bc') (d'c'^ba gfed) | (efga ^bc'd'e') (f'e'd'c' ^bagf) |
(efga ^bc'd'e') (d'c'^ba gfed) | (cdef ga^bc') (^bagf edc^B) |
(A^Bcd efga) (gfed c^BAG) | (FGA^B cdef) (edc^B AGF2) |]

X:3
T:Modo 3: Fa sostenido (Fa♯) Mixolidio
% Familia Mayor | Carácter: Festivo y folclórico | Fórmula: 1 - 2 - 3 - 4 - 5 - 6 - ♭7
%%barsperstaff 2
M:4/2
L:1/8
Q:1/2=90
K:F#
V:1 clef=treble
%%score 1
(FGAB cd=ef) (gf=ed cBAG) | (ABcd =efga) (bagf =edcB) |
(cd=ef gabc') (d'c'ba gf=ed) | (=efga bc'd'=e') (f'=e'd'c' bagf) |
(=efga bc'd'=e') (d'c'ba gf=ed) | (cd=ef gabc') (bagf =edcB) |
(ABcd =efga) (gf=ed cBAG) | (FGAB cd=ef) (=edcB AGF2) |]

